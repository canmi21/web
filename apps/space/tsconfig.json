{
	// The router runs in workerd and its development script in node, so each file reads only the
	// globals of where it runs. See the workspace's spec/code.md, "A runtime's globals decide which
	// program checks a file".
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023"],
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["src/**/*.ts"]
}
