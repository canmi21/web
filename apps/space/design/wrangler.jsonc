{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "space-design",
	// The adapter's Worker, and the client and prerendered files it serves beside the pages it
	// renders; both written by `vite build`. See spec/architecture/space.md.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-29",
	// SvelteKit keeps each request's event in `node:async_hooks`' AsyncLocalStorage.
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },

	// No route of its own: space's router reaches it through a binding. See
	// spec/architecture/space.md.

	"observability": { "logs": { "enabled": true } },
	"workers_dev": false,
	"preview_urls": false,
}
