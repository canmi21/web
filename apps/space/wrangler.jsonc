{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "space",
	// The router in front of space's parts; see spec/architecture/space.md.
	"main": "src/index.ts",
	"compatibility_date": "2026-07-29",

	// The apex, outside Access and public. A custom domain, so every deploy asserts it, as the
	// console's does; see platform's spec/architecture/platform.md.
	"routes": [{ "pattern": "canmi.app", "custom_domain": true }],

	// Each part by its binding, never by its URL; see spec/architecture/space.md.
	"services": [
		{ "binding": "DESIGN", "service": "space-design" },
		{ "binding": "RFCS", "service": "space-rfcs" },
	],

	"observability": { "logs": { "enabled": true } },
	"workers_dev": false,
	"preview_urls": false,
}
