{
	// Checked on its own, so a component reaching for `$lib` or `$app` fails here rather than
	// passing inside whichever app compiled it. See spec/architecture/workspace.md.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
