#!/bin/sh
#MISE description="Take the library from the lib checkout beside this one: `lib-local --link` to iterate on it as it is built, `lib-local` for what `release --local` published, `--off` to go back"
# A shim: the steps are lib's, `.mise/tasks/consumer/lib-local.ts` in the checkout beside this
# one, run with this repository's root, so every consumer runs one copy of them. See lib's
# spec/repository.md, "Trying a change before it is released".
set -e
root=$(cd "$(dirname "$0")/../.." && pwd)
task="$root/../lib/.mise/tasks/consumer/lib-local.ts"
if [ ! -f "$task" ]; then
	echo "lib-local: no lib checkout beside this one, at $root/../lib" >&2
	exit 1
fi
exec node "$task" "$root" "$@"
